# Copy this file to .env and fill in your own values.
# Local development can leave DATABASE_URL blank (SQLite is used locally).
# Production/Vercel: set this to your external MySQL connection string.
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DATABASE_NAME?charset=utf8mb4
# Never commit or share the real .env file.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
SECRET_KEY=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_GOOGLE_EMAILS=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set this to 1 only if your hosting platform is Render
# RENDER=1

# Online compiler: Judge0 CE endpoint (server-side only)
JUDGE0_API_URL=https://ce.judge0.com
# Add a private API token here if your Judge0 provider requires one
JUDGE0_API_KEY=
